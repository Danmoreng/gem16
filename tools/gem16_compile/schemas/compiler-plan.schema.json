{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Danmoreng/gem16/schemas/gemma4-26b-compiler-plan-v1.json",
  "title": "gem16 Gemma 4 26B compiler plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_profile",
    "head_format",
    "source_contract",
    "source_lock_sha256",
    "target_shard_bytes",
    "approved_metadata_files",
    "omitted_families",
    "tensors",
    "excluded_tensors",
    "reference_environment"
  ],
  "allOf": [
    {
      "if": {"properties": {"artifact_profile": {"const": "synthetic-copy-v1"}}},
      "then": {"properties": {"head_format": {"const": "source"}}}
    },
    {
      "if": {"properties": {"artifact_profile": {"const": "fp8-attention-partial-v1"}}},
      "then": {
        "properties": {
          "head_format": {"const": "deferred"},
          "source_contract": {"const": "gemma4-26b-source-bf16-attention-v1"},
          "source_lock_sha256": {"enum": [
            "1932b06d568ce8c72f3d2013d39ffd15dd61d37732638c2013f2220eb177a620",
            "3d9441fdebef33785e33181c335338208b8bf868cb8c7da692fd9c765cca8230"
          ]}
        }
      }
    }
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_profile": {"enum": ["synthetic-copy-v1", "fp8-attention-partial-v1"]},
    "head_format": {"enum": ["source", "deferred"]},
    "source_contract": {"type": "string", "minLength": 1},
    "source_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_shard_bytes": {"type": "integer", "minimum": 1},
    "approved_metadata_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "omitted_families": {
      "const": ["audio", "mtp", "video", "vision"]
    },
    "tensors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/tensor"}
    },
    "excluded_tensors": {
      "type": "array",
      "items": {"$ref": "#/$defs/excluded"}
    },
    "reference_environment": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "shape": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0}
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_name",
        "operation_id",
        "source_names",
        "encoder",
        "transformation",
        "transformation_version",
        "output_dtype",
        "physical_shape",
        "logical_dtype",
        "logical_shape",
        "axis_transformation",
        "quantizer_parameters",
        "dequantization_equation",
        "role",
        "residency_class",
        "disk_layout",
        "runtime_layout",
        "aliased"
      ],
      "properties": {
        "output_name": {"type": "string", "minLength": 1},
        "operation_id": {"type": "string", "minLength": 1},
        "source_names": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "encoder": {"enum": ["copy-v1", "fp8-rowwise-weight-v1", "fp8-rowwise-scale-v1"]},
        "transformation": {"type": "string", "minLength": 1},
        "transformation_version": {"type": "integer", "minimum": 1},
        "output_dtype": {"type": "string", "minLength": 1},
        "physical_shape": {"$ref": "#/$defs/shape"},
        "logical_dtype": {"type": "string", "minLength": 1},
        "logical_shape": {"$ref": "#/$defs/shape"},
        "axis_transformation": {"type": "string", "minLength": 1},
        "quantizer_parameters": {"type": "object"},
        "dequantization_equation": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "residency_class": {"type": "string", "minLength": 1},
        "disk_layout": {"type": "string", "minLength": 1},
        "runtime_layout": {"type": "string", "minLength": 1},
        "aliased": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"encoder": {"const": "copy-v1"}}},
          "then": {
            "properties": {
              "quantizer_parameters": {"const": {}},
              "transformation": {"const": "identity-copy"},
              "output_dtype": {"type": "string"}
            }
          }
        },
        {
          "if": {"properties": {"encoder": {"enum": ["fp8-rowwise-weight-v1", "fp8-rowwise-scale-v1"]}}},
          "then": {
            "properties": {
              "quantizer_parameters": {
                "const": {
                  "contract_id": "gem16.fp8_attention_rowwise",
                  "contract_version": 1,
                  "source_dtype": "BF16",
                  "output_dtype": "F8_E4M3",
                  "codec": "E4M3FN",
                  "scale_dtype": "BF16",
                  "scale_axis": "output_row",
                  "finite_max": 448.0,
                  "rounding": "nearest_even",
                  "signed_zero": "preserve",
                  "zero_row_scale": "1.0",
                  "underflow": "minimum_positive_bf16_subnormal"
                }
              },
              "transformation_version": {"const": 1},
              "axis_transformation": {"const": "identity"},
              "logical_dtype": {"const": "BF16"},
              "residency_class": {"const": "immutable_device_text"},
              "aliased": {"const": false}
            }
          }
        }
      ]
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_name", "family", "role", "residency_class", "reason"],
      "properties": {
        "source_name": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "residency_class": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
